package com.app.service;

import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;

import com.app.models.Question;
import com.app.models.QuestionWrapper;
import com.app.repo.QuestionRepo;

@Service
public class QuestionService {
	
	@Autowired
	QuestionRepo qrepo;

	public ResponseEntity getAll(){
		try {
		return  new ResponseEntity<>(qrepo.findAll(),HttpStatus.OK);
		}catch(Exception e) {
			e.printStackTrace();
		}
		return new ResponseEntity<>(new ArrayList<>(),HttpStatus.BAD_REQUEST);
	}
	
	public ResponseEntity<String> addQuestion(Question q) {
		qrepo.save(q);
		return new ResponseEntity<>("success",HttpStatus.CREATED);
	}
	
	public List<Question> searchByCategory(String cat){
		return qrepo.findByCategoryIgnoreCase(cat);
	}

	public ResponseEntity<List<Integer>> getQuesForQuiz(String category, int numOfQues) {
		Pageable pageable = PageRequest.of(0, numOfQues);
	    List<Integer> list = qrepo.findRandomQuestionsByCategory(category, pageable);
		return new ResponseEntity<>(list,HttpStatus.OK);
	}
	public ResponseEntity<List<QuestionWrapper>> getQuesFromIds(List<Integer>questionIds){
		List<QuestionWrapper>wrappers=new ArrayList<>();
		List<Question>ques=new ArrayList<>();
		for(Integer i:questionIds) {
			ques.add(qrepo.findById(i).get());
		}
		return new ResponseEntity<>(wrappers,HttpStatus.OK);
	}
 
}
