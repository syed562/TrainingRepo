server:
  port: 8765

spring:
  application:
    name: APIGateway

  cloud:
    gateway:
      routes:
        - id: quiz_service
          uri: lb://QUIZSERVICE
          predicates:
            - Path=/quiz/**
          filters:
            - StripPrefix=1

        - id: question_service
          uri: lb://QUESTIONSERVICE
          predicates:
            - Path=/question/**
          filters:
            - StripPrefix=1

eureka:
  instance:
    prefer-ip-address: true
  client:
    serviceUrl:
      defaultZone: http://localhost:8761/eureka/
