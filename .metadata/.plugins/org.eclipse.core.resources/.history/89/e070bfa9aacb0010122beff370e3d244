package com.app.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;

import com.app.models.Question;
import com.app.repo.QuestionRepo;

@Service
public class QuestionService {
	
	@Autowired
	QuestionRepo qrepo;

	public ResponseEntity getAll(){
		try {
		return  new ResponseEntity<>(qrepo.findAll(),HttpStatus.OK);
		}catch(Exception e) {
			e.printStackTrace();
		}
		return new ResponseEntity<>(new ArrayList<>(),HttpStatus.BAD_REQUEST)
	}
	
	public Question addQuestion(Question q) {
		return qrepo.save(q);
	}
	
	public List<Question> searchByCategory(String cat){
		return qrepo.findByCaseIgnoreCategory(cat);
	}
}
