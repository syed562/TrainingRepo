package com.app.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;

import com.app.models.Question;
import com.app.models.Quiz;
import com.app.repo.QuestionRepo;
import com.app.repo.QuizRepo;

@Service
public class QuizService {

	@Autowired
	QuizRepo quizRepo;
	
	@Autowired
	QuestionRepo qr;
	
	public ResponseEntity<String> createQuiz(String category, int num, String title) {
	    Pageable pageable = PageRequest.of(0, num);
	    List<Question> list = qr.findRandomQuestionsByCategory(category, pageable);

	    Quiz quiz = new Quiz();
	    quiz.setTitle(title);
	    quiz.setQuestions(list);   // <-- add selected questions to quiz

	    quizRepo.save(quiz);       // will also save in quiz_questions table

	    return new ResponseEntity<>("created", HttpStatus.CREATED);
	}

	
}
