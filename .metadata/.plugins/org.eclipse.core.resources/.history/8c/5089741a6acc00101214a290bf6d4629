server:
  port: 8765

spring:
  application:
    name: APIGateway

  cloud:
    gateway:
      routes:
        - id: quiz_service
          uri: lb://QUIZSERVICE
          predicates:
            - Path=/quiz/**
          
        - id: question_service
          uri: lb://QUESTIONSERVICE
          predicates:
            - Path=/question/**

eureka:
  client:
    serviceUrl:
      defaultZone: http://localhost:8761/eureka/
